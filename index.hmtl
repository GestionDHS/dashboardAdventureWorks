var fi=0,ti=29,selCat1=null,selSub=null,selCont=null,selCat2=null,worldFeatures=null,mapSvg=null;
function sl(a){return a.slice(fi,ti+1);}
function ss(a){return sl(a).reduce(function(s,v){return s+v;},0);}
function fmt(n){return n>=1e6?"$"+(n/1e6).toFixed(2)+"M":n>=1e3?"$"+(n/1e3).toFixed(1)+"K":"$"+Math.round(n);}
function getPaisVal(p){return selCat2?ss(PAISCAT_F[p][selCat2]):ss(PAIS_F[p]);}
function getContVal(c){return selCat2?ss(CONTCAT_F[c][selCat2]):ss(CONT_F[c]);}
function getCatVal(cat){return selCont?ss(CONTCAT_F[selCont][cat]):ss(EBC[cat]);}
function getTFact(){if(selCont&&selCat2)return ss(CONTCAT_F[selCont][selCat2]);if(selCont)return ss(CONT_F[selCont]);if(selCat2)return ss(EBC[selCat2]);return ss(EF);}
function getTQty(){if(selCont&&selCat2)return ss(CONTCAT_Q[selCont][selCat2]);if(selCont)return ss(CONT_Q[selCont]);if(selCat2)return ss(EQC[selCat2]);return ss(EQ);}

// KPIs pagina 1 con logica de subcategoria
function getP1Fact(){
  if(selSub) return ss(SC_F[selSub]);
  if(selCat1) return ss(EBC[selCat1]);
  return ss(EF);
}
function getP1Qty(){
  if(selSub) return ss(SC_Q[selSub]);
  if(selCat1) return ss(EQC[selCat1]);
  return ss(EQ);
}

function switchPage(p,el){
  document.querySelectorAll(".page").forEach(function(x){x.classList.remove("active");});
  document.querySelectorAll(".nav-item").forEach(function(x){x.classList.remove("active");});
  document.getElementById("page-"+p).classList.add("active");
  el.classList.add("active");
  if(p==="terr"&&worldFeatures)updateMap();
}
function ymToIdx(s){var i=MO.indexOf(s.slice(0,7));return i<0?-1:i;}
function applyDates(){
  var a=ymToIdx(document.getElementById("dFrom").value);
  var b=ymToIdx(document.getElementById("dTo").value);
  if(a<0)a=0;if(b<0)b=29;if(a>b){a=0;b=29;}
  fi=a;ti=b;
  document.getElementById("dInfo").textContent=(b-a+1)+" meses";
  refreshAll();
}
function resetDates(){
  document.getElementById("dFrom").value="2015-01-01";
  document.getElementById("dTo").value="2017-06-30";
  fi=0;ti=29;document.getElementById("dInfo").textContent="30 meses";refreshAll();
}
document.getElementById("dFrom").addEventListener("change",applyDates);
document.getElementById("dTo").addEventListener("change",applyDates);

function clearCat1(){selCat1=null;selSub=null;renderP1();}
function clearSub(){selSub=null;renderP1();}

function renderP1(){
  // badge categoria
  var b1=document.getElementById("fb1");
  if(selCat1){b1.classList.add("on");document.getElementById("fl1").textContent=selCat1;}else{b1.classList.remove("on");}
  // badge subcategoria
  var bSub=document.getElementById("fbSub");
  if(selSub){bSub.classList.add("on");document.getElementById("flSub").textContent=selSub;}else{bSub.classList.remove("on");}
  // KPIs
  document.getElementById("kf").textContent=fmt(getP1Fact());
  document.getElementById("kq").textContent=Math.round(getP1Qty()).toLocaleString();
  // leyenda categorias
  var l=document.getElementById("leg1");l.innerHTML="";
  var tot=ss(EF);
  CATS.forEach(function(c){
    var pct=tot>0?(ss(EBC[c])/tot*100).toFixed(1):0;
    var el=document.createElement("span");
    el.className="li"+(selCat1===c?" sel":"");
    el.innerHTML='<span class="ldot" style="background:'+CC[c]+'"></span>'+c+" "+pct+"%";
    el.onclick=(function(cat){return function(){
      selSub=null; // limpiar subcategoria al cambiar categoria
      selCat1=selCat1===cat?null:cat;
      renderP1();
    };})(c);
    l.appendChild(el);
  });
  updatePie1();updateHbar();updateLine1();
}

var pie1c,hbarc,line1c;
function initPie1(){
  pie1c=new Chart(document.getElementById("pie1").getContext("2d"),{
    type:"pie",
    data:{labels:CATS,datasets:[{data:CATS.map(function(c){return ss(EBC[c]);}),backgroundColor:CATS.map(function(c){return CC[c];}),borderWidth:2,borderColor:"#0f1117"}]},
    options:{responsive:true,maintainAspectRatio:false,
      onClick:function(_,els){
        var c=els.length?CATS[els[0].index]:null;
        selSub=null;
        selCat1=selCat1===c?null:c;
        renderP1();
      },
      plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){var t=ctx.dataset.data.reduce(function(a,b){return a+b;},0);return ctx.label+": "+(ctx.parsed/t*100).toFixed(1)+"%";}}}}
    }
  });
}
function updatePie1(){
  if(!pie1c)return;
  pie1c.data.datasets[0].data=CATS.map(function(c){return ss(EBC[c]);});
  pie1c.data.datasets[0].backgroundColor=CATS.map(function(c){return(!selCat1||selCat1===c)?CC[c]:CC[c]+"40";});
  pie1c.update();
}

function getVisibleSC(){
  return SC.filter(function(s){return!selCat1||s.cat===selCat1;})
    .map(function(s){return{cat:s.cat,name:s.name,qty:ss(s.qty)};})
    .filter(function(s){return s.qty>0;})
    .sort(function(a,b){return b.qty-a.qty;});
}

function initHbar(){
  var d=getVisibleSC();
  document.getElementById("hbw").style.height=Math.max(200,d.length*30+60)+"px";
  hbarc=new Chart(document.getElementById("hbar").getContext("2d"),{
    type:"bar",
    data:{labels:d.map(function(s){return s.name;}),datasets:[{data:d.map(function(s){return s.qty;}),backgroundColor:d.map(function(s){return CC[s.cat];}),borderWidth:0}]},
    options:{indexAxis:"y",responsive:true,maintainAspectRatio:false,animation:{duration:200},
      onClick:function(_,els){
        if(!els.length)return;
        var name=hbarc.data.labels[els[0].index];
        selSub=selSub===name?null:name;
        // si la subcategoria seleccionada no corresponde a la categoria activa, limpiar categoria
        if(selSub){
          var found=SC.find(function(s){return s.name===selSub;});
          if(found&&selCat1&&found.cat!==selCat1){selCat1=null;}
        }
        renderP1();
      },
      plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return ctx.parsed.x.toLocaleString()+" articulos";}}}},
      scales:{
        x:{ticks:{color:"#4a5568",font:{size:10},callback:function(v){return v>=1000?(v/1000).toFixed(0)+"K":v;}},grid:{color:"rgba(255,255,255,.04)"},title:{display:true,text:"Articulos Vendidos",color:"#4a5568",font:{size:10}}},
        y:{ticks:{color:"#8b95a8",font:{size:10}},grid:{display:false}}
      }
    }
  });
}

function updateHbar(){
  if(!hbarc)return;
  var d=getVisibleSC();
  hbarc.data.labels=d.map(function(s){return s.name;});
  // color: resaltar subcategoria seleccionada
  hbarc.data.datasets[0].data=d.map(function(s){return s.qty;});
  hbarc.data.datasets[0].backgroundColor=d.map(function(s){
    var base=CC[s.cat];
    if(selSub&&selSub!==s.name)return base+"40";
    return base;
  });
  document.getElementById("hbw").style.height=Math.max(200,d.length*30+60)+"px";
  hbarc.update();
}

function initLine1(){
  line1c=new Chart(document.getElementById("line1").getContext("2d"),{
    data:{labels:sl(ML),datasets:[
      {type:"line",label:"Facturacion",data:sl(EF),borderColor:"#6b7280",borderWidth:2,pointRadius:0,yAxisID:"y",tension:0.3,fill:false},
      {type:"bar",label:"Cantidad",data:sl(EQ),backgroundColor:"rgba(255,255,255,.1)",borderColor:"rgba(255,255,255,.2)",borderWidth:1,yAxisID:"y2"}
    ]},
    options:{responsive:true,maintainAspectRatio:false,animation:{duration:200},plugins:{legend:{display:false}},
      scales:{
        x:{ticks:{color:"#4a5568",font:{size:9},maxRotation:45,autoSkip:false},grid:{color:"rgba(255,255,255,.04)"}},
        y:{position:"left",ticks:{color:"#4a5568",font:{size:10},callback:function(v){return v>=1e6?(v/1e6).toFixed(1)+"M":(v/1e3).toFixed(0)+"K";}},grid:{color:"rgba(255,255,255,.04)"},title:{display:true,text:"Facturacion",color:"#4a5568",font:{size:10}}},
        y2:{position:"right",ticks:{color:"#4a5568",font:{size:10},callback:function(v){return v>=1000?(v/1000).toFixed(0)+"K":v;}},grid:{display:false},title:{display:true,text:"Cantidad",color:"#4a5568",font:{size:10}}}
      }
    }
  });
}

function updateLine1(){
  if(!line1c)return;
  var factData,qtyData,col;
  if(selSub){
    factData=sl(SC_F[selSub]);
    qtyData=sl(SC_Q[selSub]);
    // color segun categoria de la subcategoria
    var found=SC.find(function(s){return s.name===selSub;});
    col=found?CC[found.cat]:"#637aff";
  } else if(selCat1){
    factData=sl(EBC[selCat1]);
    qtyData=sl(EQC[selCat1]);
    col=CC[selCat1];
  } else {
    factData=sl(EF);
    qtyData=sl(EQ);
    col="#6b7280";
  }
  line1c.data.labels=sl(ML);
  line1c.data.datasets[0].data=factData;
  line1c.data.datasets[0].borderColor=col;
  line1c.data.datasets[1].data=qtyData;
  line1c.data.datasets[1].backgroundColor=col+"33";
  line1c.data.datasets[1].borderColor=col+"66";
  line1c.update();
}

// PAGE 2
function clearCont(){selCont=null;renderP2();}
function clearCat2(){selCat2=null;renderP2();}
function renderP2(){
  var bc=document.getElementById("fbCont");
  if(selCont){bc.classList.add("on");document.getElementById("flCont").textContent=selCont;}else{bc.classList.remove("on");}
  var bk=document.getElementById("fbCat2");
  if(selCat2){bk.classList.add("on");document.getElementById("flCat2").textContent=selCat2;}else{bk.classList.remove("on");}
  document.getElementById("kft").textContent=fmt(getTFact());
  document.getElementById("kqt").textContent=Math.round(getTQty()).toLocaleString();
  var lc=document.getElementById("leg2cont");lc.innerHTML="";
  CONTS.forEach(function(c){
    var el=document.createElement("span");
    el.className="li"+(selCont===c?" sel":"");
    el.innerHTML='<span class="ldot" style="background:'+CONT_C[c]+'"></span>'+c+" "+fmt(getContVal(c));
    el.onclick=(function(cont){return function(){selCont=selCont===cont?null:cont;renderP2();};})(c);
    lc.appendChild(el);
  });
  var lk=document.getElementById("leg2cat");lk.innerHTML="";
  var tot=CATS.reduce(function(s,c){return s+getCatVal(c);},0);
  CATS.forEach(function(c){
    var pct=tot>0?(getCatVal(c)/tot*100).toFixed(1):0;
    var el=document.createElement("span");
    el.className="li"+(selCat2===c?" sel":"");
    el.innerHTML='<span class="ldot" style="background:'+CC[c]+'"></span>'+c+" "+pct+"%";
    el.onclick=(function(cat){return function(){selCat2=selCat2===cat?null:cat;renderP2();};})(c);
    lk.appendChild(el);
  });
  updatePie2();updateTbar();updateMap();
}
var pie2c,tbarc;
function initPie2(){
  pie2c=new Chart(document.getElementById("pie2").getContext("2d"),{
    type:"pie",
    data:{labels:CATS,datasets:[{data:CATS.map(function(c){return getCatVal(c);}),backgroundColor:CATS.map(function(c){return CC[c];}),borderWidth:2,borderColor:"#0f1117"}]},
    options:{responsive:true,maintainAspectRatio:false,
      onClick:function(_,els){var c=els.length?CATS[els[0].index]:null;selCat2=selCat2===c?null:c;renderP2();},
      plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){var t=ctx.dataset.data.reduce(function(a,b){return a+b;},0);return ctx.label+": "+(ctx.parsed/t*100).toFixed(1)+"%";}}}}
    }
  });
}
function updatePie2(){
  if(!pie2c)return;
  pie2c.data.datasets[0].data=CATS.map(function(c){return getCatVal(c);});
  pie2c.data.datasets[0].backgroundColor=CATS.map(function(c){return(!selCat2||selCat2===c)?CC[c]:CC[c]+"40";});
  pie2c.update();
}
function initTbar(){
  tbarc=new Chart(document.getElementById("tbar").getContext("2d"),{
    type:"bar",
    data:{labels:CONTS,datasets:[{data:CONTS.map(function(c){return getContVal(c);}),backgroundColor:CONTS.map(function(c){return CONT_C[c];}),borderWidth:0,borderRadius:3}]},
    options:{responsive:true,maintainAspectRatio:false,animation:{duration:200},
      onClick:function(_,els){var c=els.length?CONTS[els[0].index]:null;selCont=selCont===c?null:c;renderP2();},
      plugins:{legend:{display:false},tooltip:{callbacks:{label:function(ctx){return "$"+(ctx.parsed.y/1e6).toFixed(2)+"M";}}}},
      scales:{x:{ticks:{color:"#8b95a8",font:{size:11}},grid:{display:false}},y:{ticks:{color:"#4a5568",font:{size:10},callback:function(v){return "$"+(v/1e6).toFixed(1)+"M";}},grid:{color:"rgba(255,255,255,.04)"}}}
    }
  });
}
function updateTbar(){
  if(!tbarc)return;
  tbarc.data.datasets[0].data=CONTS.map(function(c){return getContVal(c);});
  tbarc.data.datasets[0].backgroundColor=CONTS.map(function(c){return(!selCont||selCont===c)?CONT_C[c]:CONT_C[c]+"40";});
  tbarc.update();
}
function updateMap(){
  if(!mapSvg||!worldFeatures)return;
  var paises=Object.keys(PAIS_ISO);
  var active=paises.filter(function(p){return!selCont||PAIS_CONT[p]===selCont;});
  var maxVal=Math.max.apply(null,active.map(function(p){return getPaisVal(p);}));
  if(maxVal<=0)maxVal=1;
  var cs=d3.scaleSequential([0,maxVal],d3.interpolatePurples);
  mapSvg.selectAll("path")
    .attr("fill",function(d){
      var p=paises.find(function(k){return PAIS_ISO[k]===String(d.id);});
      if(!p)return"rgba(255,255,255,0.04)";
      if(selCont&&PAIS_CONT[p]!==selCont)return"rgba(255,255,255,0.03)";
      return cs(getPaisVal(p));
    })
    .attr("opacity",function(d){
      var p=paises.find(function(k){return PAIS_ISO[k]===String(d.id);});
      return(p&&selCont&&PAIS_CONT[p]!==selCont)?0.15:1;
    });
}
function initMap(){
  var W=document.getElementById("mapWrap").clientWidth||700;
  var H=300;
  mapSvg=d3.select("#mapWrap").append("svg").attr("viewBox","0 0 "+W+" "+H).attr("width","100%").style("background","#0a0d14");
  var proj=d3.geoNaturalEarth1().scale(W/6.3).translate([W/2,H/2]);
  var pathG=d3.geoPath(proj);
  var tip=document.getElementById("mapTip");
  d3.json("https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json").then(function(world){
    worldFeatures=topojson.feature(world,world.objects.countries).features;
    document.getElementById("mapLoad").style.display="none";
    mapSvg.selectAll("path").data(worldFeatures).join("path")
      .attr("d",pathG).attr("fill","rgba(255,255,255,0.04)").attr("stroke","rgba(255,255,255,0.08)").attr("stroke-width",0.4).style("cursor","pointer")
      .on("mousemove",function(evt,d){
        var p=Object.keys(PAIS_ISO).find(function(k){return PAIS_ISO[k]===String(d.id);});
        if(!p)return;
        tip.style.display="block";tip.style.left=(evt.clientX+12)+"px";tip.style.top=(evt.clientY-28)+"px";
        tip.innerHTML=p+"<br>"+fmt(getPaisVal(p));
      })
      .on("mouseleave",function(){tip.style.display="none";})
      .on("click",function(_,d){
        var p=Object.keys(PAIS_ISO).find(function(k){return PAIS_ISO[k]===String(d.id);});
        if(!p)return;
        var c=PAIS_CONT[p];selCont=selCont===c?null:c;renderP2();
      });
    updateMap();
  }).catch(function(){document.getElementById("mapLoad").textContent="Mapa no disponible";});
}
function refreshAll(){renderP1();renderP2();}
initPie1();initHbar();initLine1();renderP1();
initPie2();initTbar();initMap();renderP2();

</script>
</body>
</html>
