<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Adventure Works Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"IBM Plex Sans",sans-serif;background:#0f1117;color:#c8d0db;min-height:100vh}
.shell{display:flex;min-height:100vh}
.nav{width:200px;background:#0a0d14;padding:20px 0;flex-shrink:0;border-right:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column}
.nav-logo{padding:0 20px 24px;border-bottom:1px solid rgba(255,255,255,.06);margin-bottom:16px}
.nav-logo h2{font-family:"IBM Plex Mono",monospace;font-size:11px;font-weight:600;color:#637aff;letter-spacing:3px;text-transform:uppercase}
.nav-logo p{font-size:11px;color:#4a5568;margin-top:3px}
.nav-item{padding:10px 20px;color:#8b95a8;cursor:pointer;font-size:13px;border-left:2px solid transparent;transition:all .15s;display:flex;align-items:center;gap:8px}
.nav-item i{font-size:16px}
.nav-item:hover{color:#c8d0db;background:rgba(255,255,255,.03);border-left-color:rgba(99,122,255,.4)}
.nav-item.active{color:#fff;background:rgba(99,122,255,.1);border-left-color:#637aff}
.nav-footer{margin-top:auto;padding:16px 20px;border-top:1px solid rgba(255,255,255,.06);font-size:11px;color:#4a5568}
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0}
.topbar{background:#0a0d14;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.06);flex-wrap:wrap;gap:10px}
.topbar-title{font-family:"IBM Plex Mono",monospace;font-size:13px;font-weight:600;color:#fff;letter-spacing:1px}
.datebar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.datebar label{font-size:11px;color:#8b95a8;font-family:"IBM Plex Mono",monospace}
.datebar input[type=date]{background:#1a1f2e;border:1px solid rgba(255,255,255,.1);border-radius:4px;color:#c8d0db;font-size:12px;font-family:"IBM Plex Mono",monospace;padding:5px 8px;outline:none;cursor:pointer}
.datebar input[type=date]:focus{border-color:#637aff}
.dsep{color:#4a5568;font-size:12px}
.dreset{background:transparent;border:1px solid rgba(255,255,255,.1);border-radius:4px;color:#8b95a8;font-size:11px;padding:5px 12px;cursor:pointer;font-family:"IBM Plex Mono",monospace}
.dreset:hover{border-color:#637aff;color:#637aff}
.dinfo{font-size:11px;color:#637aff;font-family:"IBM Plex Mono",monospace}
.content{flex:1;padding:20px 24px;overflow:auto;background:#0f1117}
.page{display:none}.page.active{display:block}
.topbar2{display:flex;align-items:center;gap:8px;margin-bottom:14px;flex-wrap:wrap}
.fbadge{display:none;align-items:center;gap:6px;background:rgba(99,122,255,.15);border:1px solid rgba(99,122,255,.35);border-radius:4px;padding:4px 10px;font-size:11px;color:#a0aec0;cursor:pointer;font-family:"IBM Plex Mono",monospace}
.fbadge.on{display:inline-flex}.fbadge span{color:#637aff;font-weight:600}
.fbadge:hover{background:rgba(99,122,255,.25)}
.krow{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.kcard{background:#141824;border:1px solid rgba(255,255,255,.06);border-radius:6px;padding:16px 20px}
.klabel{font-size:10px;color:#8b95a8;margin-bottom:6px;font-family:"IBM Plex Mono",monospace;letter-spacing:1px;text-transform:uppercase}
.kval{font-size:26px;font-weight:600;color:#fff;font-family:"IBM Plex Mono",monospace;letter-spacing:-1px}
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ccard{background:#141824;border:1px solid rgba(255,255,255,.06);border-radius:6px;padding:16px;min-width:0}
.ccard.wide{grid-column:1/-1}
.ctitle{font-size:10px;color:#637aff;margin-bottom:10px;font-family:"IBM Plex Mono",monospace;letter-spacing:2px;text-transform:uppercase}
.leg{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.li{display:flex;align-items:center;gap:5px;font-size:11px;color:#8b95a8;cursor:pointer;padding:3px 8px;border-radius:3px;border:1px solid transparent;transition:all .15s;white-space:nowrap;font-family:"IBM Plex Mono",monospace}
.li:hover{background:rgba(255,255,255,.05)}.li.sel{border-color:rgba(255,255,255,.2);color:#fff;background:rgba(255,255,255,.04)}
.ldot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.tip{position:fixed;background:#1a1f2e;border:1px solid rgba(99,122,255,.3);border-radius:4px;padding:8px 12px;font-size:12px;color:#fff;pointer-events:none;display:none;z-index:100;font-family:"IBM Plex Mono",monospace}
</style>
</head>
<body>
<div class="shell">
  <div class="nav">
    <div class="nav-logo"><h2>AWorks</h2><p>Sales Dashboard</p></div>
    <div class="nav-item active" onclick="switchPage('cats',this)"><i class="ti ti-chart-pie"></i>Categorias</div>
    <div class="nav-item" onclick="switchPage('terr',this)"><i class="ti ti-map"></i>Territorios</div>
    <div class="nav-footer">Adventure Works 2015-2017</div>
  </div>
  <div class="main">
    <div class="topbar">
      <div class="topbar-title">ADVENTURE WORKS</div>
      <div class="datebar">
        <i class="ti ti-calendar" style="color:#637aff;font-size:16px"></i>
        <label>Desde</label>
        <input type="date" id="dFrom" value="2015-01-01" min="2015-01-01" max="2017-06-30">
        <span class="dsep">to</span>
        <label>Hasta</label>
        <input type="date" id="dTo" value="2017-06-30" min="2015-01-01" max="2017-06-30">
        <button class="dreset" onclick="resetDates()">Reset</button>
        <span class="dinfo" id="dInfo">30 meses</span>
      </div>
    </div>
    <div class="content">
      <div class="page active" id="page-cats">
        <div class="topbar2">
          <div class="fbadge" id="fb1" onclick="clearCat1()">CAT: <span id="fl1"></span> X</div>
          <div class="fbadge" id="fbSub" onclick="clearSub()">SUB: <span id="flSub"></span> X</div>
        </div>
        <div class="krow">
          <div class="kcard"><div class="klabel">Facturacion</div><div class="kval" id="kf">-</div></div>
          <div class="kcard"><div class="klabel">Articulos Vendidos</div><div class="kval" id="kq">-</div></div>
        </div>
        <div class="cgrid">
          <div class="ccard">
            <div class="ctitle">Ventas por Categoria</div>
            <div class="leg" id="leg1"></div>
            <div style="position:relative;height:200px"><canvas id="pie1"></canvas></div>
          </div>
          <div class="ccard">
            <div class="ctitle">Ventas por Subcategoria </div>
            <div style="position:relative" id="hbw"><canvas id="hbar"></canvas></div>
          </div>
          <div class="ccard wide">
            <div class="ctitle">Evolucion de Ventas</div>
            <div class="leg">
              <span class="li"><span style="display:inline-block;width:18px;height:2px;background:#9e9e9e;vertical-align:middle;margin-right:2px"></span>Facturacion</span>
              <span class="li"><span style="display:inline-block;width:10px;height:10px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);margin-right:2px"></span>Cantidad</span>
            </div>
            <div style="position:relative;height:200px"><canvas id="line1"></canvas></div>
          </div>
        </div>
      </div>
      <div class="page" id="page-terr">
        <div class="topbar2">
          <div class="fbadge" id="fbCont" onclick="clearCont()">CONT: <span id="flCont"></span> X</div>
          <div class="fbadge" id="fbCat2" onclick="clearCat2()">CAT: <span id="flCat2"></span> X</div>
        </div>
        <div class="krow">
          <div class="kcard"><div class="klabel">Facturacion</div><div class="kval" id="kft">-</div></div>
          <div class="kcard"><div class="klabel">Articulos Vendidos</div><div class="kval" id="kqt">-</div></div>
        </div>
        <div class="cgrid">
          <div class="ccard">
            <div class="ctitle">Ventas por Categoria</div>
            <div class="leg" id="leg2cat"></div>
            <div style="position:relative;height:200px"><canvas id="pie2"></canvas></div>
          </div>
          <div class="ccard">
            <div class="ctitle">Facturacion por Continente</div>
            <div class="leg" id="leg2cont"></div>
            <div style="position:relative;height:200px"><canvas id="tbar"></canvas></div>
          </div>
          <div class="ccard wide">
            <div class="ctitle">Mapa de Ventas por Pais</div>
            <div id="mapWrap" style="width:100%;height:300px;border-radius:4px;overflow:hidden;background:#0a0d14;position:relative;">
              <div id="mapLoad" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#4a5568;font-size:13px;font-family:IBM Plex Mono,monospace">Cargando mapa...</div>
            </div>
            <div style="display:flex;gap:12px;margin-top:8px;align-items:center">
              <span style="font-size:11px;color:#4a5568;font-family:IBM Plex Mono,monospace">Facturacion:</span>
              <span style="display:inline-block;width:80px;height:6px;border-radius:3px;background:linear-gradient(to right,#312e81,#7c3aed,#a78bfa)"></span>
              <span style="font-size:11px;color:#4a5568;font-family:IBM Plex Mono,monospace">menor a mayor</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="tip" id="mapTip"></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/d3@7.8.5/dist/d3.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3.1.0/dist/topojson-client.min.js"></script>
<script>

